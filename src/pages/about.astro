---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Hi! I'm @dwanat.",
	title: "About",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">About</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<p>I'm Dominika Wanat (@dwanat), an HPC storage engineer from Poland.</p>
		<p>I work mostly with:</p>
		<ul class="list-inside list-disc" role="list">
			<li>Lustre architecture, design and implementation</li>
			<li>ZFS tuning and performance</li>
			<li>Storage hardware and firmware</li>
			<li>Linux kernel tuning and debugging</li>
			<li>Distributed filesystems</li>
			<li>Linux performance and reliability</li>
		</ul>
	</div>
</PageLayout>
